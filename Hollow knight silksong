// Vite plugin that emits /threadfall-offline.html: the whole game in one file
// (inline script + styles) so players can save it and run it without a connection.

import { build, type Plugin } from 'vite'

export const OFFLINE_FILE = 'threadfall-offline.html'
const ENTRY = 'src/game/offline.ts'

async function bundleGame(root: string) {
  const out = await build({
    root,
    configFile: false,
    logLevel: 'silent',
    build: {
      write: false,
      minify: true,
      lib: {
        entry: ENTRY,
        formats: ['iife'],
        name: 'Threadfall',
        fileName: 'threadfall',
      },
    },
  })
  const result = Array.isArray(out) ? out[0] : out
  if (!('output' in result)) throw new Error('Unexpected offline build result')
  const chunk = result.output.find((o) => o.type === 'chunk')
  if (!chunk || chunk.type !== 'chunk')
    throw new Error('Offline build produced no script')
  // Keep a literal "</script>" in the bundle from closing the inline tag early.
  return chunk.code.replace(/<\/script/gi, '<\\/script')
}

export function offlineDownload(): Plugin {
  let root = ''
  return {
    name: 'threadfall-offline-download',
    configResolved(config) {
      root = config.root
    },
    configureServer(server) {
      server.middlewares.use(`/${OFFLINE_FILE}`, (_req, res, next) => {
        bundleGame(root)
          .then((js) => {
            res.setHeader('Content-Type', 'text/html; charset=utf-8')
            res.end(page(js))
          })
          .catch(next)
      })
    },
    async generateBundle() {
      if (this.environment.name !== 'client') return
      this.emitFile({
        type: 'asset',
        fileName: OFFLINE_FILE,
        source: page(await bundleGame(root)),
      })
    },
  }
}

