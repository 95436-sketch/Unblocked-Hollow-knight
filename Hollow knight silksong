// Entry for the downloadable single-file copy (threadfall-offline.html).
// Plain DOM instead of React so the whole game inlines into one small script.

import {
  ThreadfallGame,
  formatTime,
  type RunStats,
  type Status,
} from './engine'

const BEST_KEY = 'threadfall:best'

const $ = <T extends HTMLElement>(id: string) =>
  document.getElementById(id) as T

function readBest() {
  try {
    return Number(localStorage.getItem(BEST_KEY)) || 0
  } catch {
    // file:// pages can have storage disabled; best time is optional.
    return 0
  }
}

function writeBest(t: number) {
  try {
    localStorage.setItem(BEST_KEY, String(t))
  } catch {
    /* ignore */
  }
}

function boot() {
  const stage = $<HTMLDivElement>('stage')
  const overlays: Record<'title' | 'paused' | 'won', HTMLElement> = {
    title: $('ov-title'),
    paused: $('ov-paused'),
    won: $('ov-won'),
  }
  const pauseBtn = $<HTMLButtonElement>('btn-pause')
  const muteBtn = $<HTMLButtonElement>('btn-mute')
  let status: Status = 'title'
  let muted = false

  const showBest = () => {
    const best = readBest()
    $('best').textContent = best > 0 ? `Best ascent ${formatTime(best)}` : ''
  }

  const onStatus = (s: Status, st: RunStats) => {
    status = s
    for (const [k, el] of Object.entries(overlays)) el.hidden = k !== s
    pauseBtn.hidden = s !== 'playing' && s !== 'paused'
    pauseBtn.textContent = s === 'paused' ? '▶' : '❚❚'
    if (s === 'won') {
      $('st-time').textContent = formatTime(st.time)
      $('st-glimmer').textContent = `${st.glimmer}/${st.totalGlimmer}`
      $('st-falls').textContent = String(st.deaths)
      const prev = readBest() || Infinity
      const record = st.time < prev
      $('new-best').hidden = !record
      if (record) writeBest(st.time)
    }
    if (s === 'title') showBest()
    overlays[s as keyof typeof overlays]
      ?.querySelector<HTMLButtonElement>('button')
      ?.focus()
  }

  const game = new ThreadfallGame($<HTMLCanvasElement>('screen'), onStatus)
  showBest()

  const begin = () => {
    game.start()
    stage.focus()
  }

  document
    .querySelectorAll('[data-begin]')
    .forEach((b) => b.addEventListener('click', begin))
  $('btn-resume').addEventListener('click', () => game.resume())
  pauseBtn.addEventListener('click', () => {
    game.togglePause()
    pauseBtn.blur()
  })
  muteBtn.addEventListener('click', () => {
    muted = !muted
    game.setMuted(muted)
    muteBtn.textContent = muted ? '🔇' : '🔊'
    muteBtn.setAttribute('aria-label', muted ? 'Unmute' : 'Mute')
    muteBtn.blur()
  })
  $('btn-full').addEventListener('click', (e) => {
    if (document.fullscreenElement) void document.exitFullscreen()
    else void stage.requestFullscreen?.()
    ;(e.currentTarget as HTMLElement).blur()
  })

  window.addEventListener('keydown', (e) => {
    if (e.code === 'Enter' && (status === 'title' || status === 'won')) begin()
  })
  window.addEventListener('resize', () => game.resize())
  document.addEventListener(
    'visibilitychange',
    () => document.hidden && game.pause(),
  )
}

